<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
  <model name="OfficeChairGrey">
    <static>true</static>
    <link name="body">
      <pose>0 0 0 0 0 0</pose>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://OfficeChairGrey/meshes/OfficeChairGrey.obj</uri>
            <scale>1.3 1.3 1.7</scale> <!-- 缩放比例 -->
          </mesh>
        </geometry>
      </visual>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://OfficeChairGrey/meshes/OfficeChairGrey_Col.obj</uri>
            <scale>1.3 1.3 1.7</scale> <!-- 缩放比例 -->
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
